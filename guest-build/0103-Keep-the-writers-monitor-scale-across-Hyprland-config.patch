         and 'state_file=${OMARCHY_DISPLAY_SYNC_STATE:-${XDG_RUNTIME_DIR:-/run/user/$UID}/try-omarchy/display-mode}'
         in read(display_sync),
-        "QEMU profile keeps the synced display mode across config reloads",
