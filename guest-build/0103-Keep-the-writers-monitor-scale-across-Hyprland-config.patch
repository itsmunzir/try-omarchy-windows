From ff91c9967e97876bbc1ea944c41268b89e557f18 Mon Sep 17 00:00:00 2001
From: itsmunzir <itsmunzir@users.noreply.github.com>
Date: Mon, 28 Sep 2026 09:50:52 +0300
Subject: [PATCH] Keep the writer's monitor scale across Hyprland config
 reloads

Display sync replaced the scale from monitors.lua with the scale it guessed from the EDID. A writer set omarchy_monitor_scale to 3. After each config reload the scale returned to 1.

The script now reads that variable. A number wins over the EDID scale. auto keeps the old behavior. The QEMU profile fragment applies the same rule to the recorded mode. Compatibility revision 40 delivers the script and the fragment to existing guests.
---
 .../hypr-monitors-qemu.append.lua             |  6 +++
 guest/fragments/hypr-monitors-qemu.append.lua |  6 +++
 .../usr/local/bin/omarchy-native-display-sync | 36 +++++++++++--
 guest/scripts/finalize-rootfs.sh              |  4 +-
 guest/tests/verify.py                         | 51 ++++++++++++++++++-
 5 files changed, 95 insertions(+), 8 deletions(-)

diff --git a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
index e388dce..54924e8 100644
--- a/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
+++ b/guest/factory-overlay/usr/share/try-omarchy/skel-fragments/hypr-monitors-qemu.append.lua
@@ -61,6 +61,12 @@ if omarchy_kernel_option_enabled("omarchy.qemu=1") then
   hl.config({ cursor = { invisible = false } })
   local synced_mode, synced_scale = omarchy_synced_display_mode()
   if synced_mode then
+    -- A number the writer set in this file is explicit intent and outranks
+    -- the scale guessed from the EDID; "auto" keeps the guessed scale.
+    local user_scale = tostring(omarchy_monitor_scale or "")
+    if user_scale:match("^%d+%.?%d*$") then
+      synced_scale = user_scale
+    end
     hl.monitor({ output = "", mode = synced_mode, scale = synced_scale })
   end
   o.exec_on_start("/usr/local/bin/omarchy-native-display-sync")
