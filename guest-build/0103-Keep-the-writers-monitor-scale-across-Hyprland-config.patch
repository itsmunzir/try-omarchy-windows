     )
     check(
         'omarchy_kernel_option_enabled("tryomarchy.render=cpu")' in monitor_fragment
@@ -562,6 +564,51 @@ HOTPLUG=1
             == "modeline 1236 5120 6400 6553 6912 2880 2894 2908 2980 -hsync -vsync\n2\n",
             "native display sync records the single display's mode for config reloads",
         )
+        monitor_config = temporary_path / "monitors.lua"
+        monitor_config.write_text(
+            'local omarchy_monitor_scale = 3\n'
+            'hl.monitor({ output = "", mode = "preferred", position = "auto", scale = omarchy_monitor_scale })\n',
+            encoding="utf-8",
