+        check(
+            configured_state.read_text(encoding="utf-8").endswith("\n2\n"),
+            "an automatic scale keeps the EDID-derived scale",
+        )
         (legacy_connector / "status").write_text("connected\n", encoding="utf-8")
         applied_before_reloads = len(reload_log.read_text(encoding="utf-8").splitlines())
         subprocess.run(
