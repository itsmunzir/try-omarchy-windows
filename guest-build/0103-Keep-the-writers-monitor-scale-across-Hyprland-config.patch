+        configured_environment = dict(environment)
+        configured_environment["OMARCHY_DISPLAY_SYNC_CONFIG"] = str(monitor_config)
+        configured_state = temporary_path / "runtime-configured/try-omarchy/display-mode"
+        configured_environment["OMARCHY_DISPLAY_SYNC_STATE"] = str(configured_state)
+        configured_log = temporary_path / "reloads-configured"
+        configured_environment["HYPRCTL_LOG"] = str(configured_log)
+        subprocess.run(
+            [str(display_sync), "--from-stdin"],
+            input="ACTION=change\nSUBSYSTEM=drm\nHOTPLUG=1\n",
+            text=True,
+            env=configured_environment,
+            check=True,
+        )
+        check(
+            configured_state.read_text(encoding="utf-8")
+            == "modeline 1236 5120 6400 6553 6912 2880 2894 2908 2980 -hsync -vsync\n3\n",
+            "native display sync keeps the scale the writer set in monitors.lua",
+        )
+        check(
+            configured_log.read_text(encoding="utf-8").splitlines()
+            == [
+                'eval hl.monitor({ output = "", mode = "modeline 1236 5120 6400 6553 6912 2880 2894 2908 2980 -hsync -vsync", scale = "3" })'
+            ],
+            "native display sync applies the writer's scale to the catch-all rule",
+        )
+        monitor_config.write_text('local omarchy_monitor_scale = "auto"\n', encoding="utf-8")
+        configured_state.unlink()
+        configured_log.unlink()
+        subprocess.run(
+            [str(display_sync), "--from-stdin"],
+            input="ACTION=change\nSUBSYSTEM=drm\nHOTPLUG=1\n",
+            text=True,
+            env=configured_environment,
+            check=True,
