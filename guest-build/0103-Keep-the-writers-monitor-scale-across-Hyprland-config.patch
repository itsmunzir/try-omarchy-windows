diff --git a/guest/native-overlay/usr/local/bin/omarchy-native-display-sync b/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
index e4bedfc..37c92d4 100755
--- a/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
+++ b/guest/native-overlay/usr/local/bin/omarchy-native-display-sync
@@ -7,6 +7,20 @@ drm_root=${OMARCHY_DISPLAY_SYNC_DRM_ROOT:-/sys/class/drm}
 # config reload keeps that mode instead of falling back to "preferred".
 state_file=${OMARCHY_DISPLAY_SYNC_STATE:-${XDG_RUNTIME_DIR:-/run/user/$UID}/try-omarchy/display-mode}
 
+# Omarchy's monitors.lua keeps the writer's catch-all scale in a Lua variable.
+# A number there is explicit intent and outranks the scale guessed from the
+# EDID; "auto", a missing file, and an unreadable file keep the guessed scale.
+configured_scale() {
+  local config=${OMARCHY_DISPLAY_SYNC_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hypr/monitors.lua}
+  local value=""
+
+  [[ -r $config ]] || return 0
+  value=$(sed -n 's/^[[:space:]]*\(local[[:space:]]\+\)\?omarchy_monitor_scale[[:space:]]*=[[:space:]]*"\?\([0-9][0-9.]*\)"\?.*$/\2/p' "$config")
+  value=${value%%$'\n'*}
+  [[ $value =~ ^[0-9]+(\.[0-9]+)?$ ]] || return 0
+  printf '%s\n' "$value"
+}
+
 preferred_mode_from_edid() {
   python3 - "$1" <<'PY'
 import pathlib
@@ -246,6 +260,7 @@ apply_preferred_modes() {
   local response
   local rule
   local scale
+  local user_scale=""
   local applied=0
   local last_mode=""
   local last_scale=""
@@ -263,14 +278,25 @@ apply_preferred_modes() {
     IFS=$'\t' read -r mode scale <<<"$preferred"
     [[ -n $mode && -n $scale ]] || continue
 
+    # A scale the writer set in monitors.lua is explicit intent; keep it so a
+    # reload cannot pull it back to the EDID-derived value. Read the file once
+    # per run: several displays share the single catch-all rule.
+    if [[ -z $user_scale ]]; then
+      user_scale=$(configured_scale)
+    fi
+    if [[ -n $user_scale ]]; then
+      scale=$user_scale
+    fi
+
     # Aquamarine 0.14 does not refresh its mode cache when an existing DRM
     # connector's EDID or physical size changes. A complete modeline bypasses
     # the stale mode cache; an explicit scale calculated from the fresh EDID
-    # avoids using the stale fullscreen dimensions for Hyprland's auto scale.
-    # Hyprland's Lua config parser requires eval instead of the legacy keyword
-    # command. Update Omarchy's single-output catch-all mode and dynamic scale;
-    # its placement, color, and other policy remain intact, while an explicit
-    # per-output user rule still wins.
+    # avoids using the stale fullscreen dimensions for Hyprland's auto scale —
+    # unless the writer set a number, which comes first. Hyprland's Lua config
+    # parser requires eval instead of the legacy keyword command. Update
+    # Omarchy's single-output catch-all mode and scale; its placement, color,
+    # and other policy remain intact, while an explicit per-output user rule
+    # still wins.
     rule="hl.monitor({ output = \"\", mode = \"$mode\", scale = \"$scale\" })"
     if ! response=$(hyprctl eval "$rule" 2>&1); then
       printf 'omarchy-native-display-sync: failed to apply %s to %s: %s\n' \
diff --git a/guest/scripts/finalize-rootfs.sh b/guest/scripts/finalize-rootfs.sh
